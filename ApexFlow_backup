update-url = https://raw.githubusercontent.com/isai129/SR_Conf/refs/heads/main/ApexFlow_backup

[Proxy Group]
# [FIX] 筛选器全部改成锚定式 ^[❶❷❸]xx.<区域>，实测用真实订阅名校验：
#       旧写法 (?i)(HK|TW|JP|SG|US) 会把 "✖︎被墙✖︎…HK…" 等坏节点捞进自动池；锚定后垃圾=0
# [FIX] 测速地址 http -> https（明文 204 探测会被运营商/机场劫持，健康节点被误判为死）
# [FIX] policy-select-name 用真实节点名：原来的 ❷GR…X1 / ❸GR…V6…X1 在订阅里根本不存在（大小写与 x1 写法都不同），钉节点静默失效
Auto = url-test,use=*,url=https://www.gstatic.com/generate_204,policy-regex-filter=(?i)^[❶❷❸][a-zA-Z0-9]{2}\.(HK|TW|JP|US|SG).*x1$,interval=600,timeout=3,tolerance=10,policy-select-name=❷gR.HK嘉禾|阿里云|NF* x1
HK = url-test,url=https://www.gstatic.com/generate_204,interval=3600,timeout=5,select=0,use=*,policy-regex-filter=(?i)^[❶❷❸][a-zA-Z0-9]{2}\.HK
TW = url-test,use=*,url=https://www.gstatic.com/generate_204,policy-regex-filter=(?i)^[❶❷❸][a-zA-Z0-9]{2}\.TW,select=0,policy-select-name=❸gR.TW桃园|荐|NF|D+|AI x1,timeout=5,interval=3600
JP = url-test,url=https://www.gstatic.com/generate_204,interval=3600,timeout=5,select=0,use=*,policy-regex-filter=(?i)^[❶❷❸][a-zA-Z0-9]{2}\.JP
US = url-test,use=*,url=https://www.gstatic.com/generate_204,select=0,policy-regex-filter=(?i)^[❶❷❸][a-zA-Z0-9]{2}\.US,policy-select-name=❸gR.US川谱|v6|NF|D+|AI x1,timeout=5,interval=3600
SG = url-test,url=https://www.gstatic.com/generate_204,interval=3600,timeout=5,select=0,use=*,policy-regex-filter=(?i)^[❶❷❸][a-zA-Z0-9]{2}\.SG
